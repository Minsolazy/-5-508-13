def find_min_value(numbers):
    return min(numbers) 


nums = []
for i in range(5):
    val = float(input(f"กรอกตัวเลขตัวที่ {i+1}: "))
    nums.append(val)

print("ค่าต่ำสุดคือ:", find_min_value(nums))

